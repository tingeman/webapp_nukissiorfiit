# Image and tool pins for deterministic builds (read by scripts/compile_lock.py and checked
# by tests/run.sh against the Dockerfile).

# Base image of the Dockerfile: python 3.13.18-slim (Debian 13 trixie), pinned by the index
# digest (multi-arch), as of 2026-11-09. Keep it identical to the Dockerfile's
# ARG PYTHON_IMAGE default: build_image.sh builds without --build-arg.
# To update: docker buildx imagetools inspect python:3.13-slim, then change both places and
# recompile the locks.
NUKI_PYTHON_IMAGE=python:3.13.18-slim@sha256:e48f59cdba69a3cbd9ed2cf0f348d90d45a8d350d98134cf1070bc106ee9ed90

# uv version used by scripts/compile_lock.py to write the lock files (not part of the image).
# Same as monitoring_db (MDB_UV_VERSION), so both repositories resolve the same way.
NUKI_UV_VERSION=0.8.22
