# Template of the nuki env file. NO REAL VALUES here: copy it, fill in the secrets, and
# keep the copy out of git (secrets/ is gitignored).
#
# The app reads /app/secrets/.env.<APP_ENV> at import (app/config.py), with APP_ENV set in
# the container environment (production: APP_ENV=production, so .env.production). In
# production this file is webapp_nuki.env in the dtu_sus_web_server secrets archive,
# bind-mounted read-only to /app/secrets/.env.production and readable only by uid 30000.

# Debug logging (True/False). Required.
DEBUG=False

# monitoring_db read API (data02). Optional in code (default
# http://host.docker.internal:8099/api/v1, which only works in local development), but set
# it in production. Production form: through data02's nginx on port 80, location /mdb/:
#   http://<data02-host>/mdb/api/v1        (production: http://192.38.87.126/mdb/api/v1)
# The app calls <base>/metadata and <base>/measurements.
BACKEND_API_BASE_URL=http://<data02-host>/mdb/api/v1
# Optional, defaults shown: request timeout (s), retries of 504 / connection errors, backoff.
BACKEND_API_TIMEOUT_SECONDS=30
BACKEND_API_MAX_RETRIES=2
BACKEND_API_BACKOFF_FACTOR=0.5

# InfluxDB (data02, port 8086). Required by config.py although the app's data comes from
# the API; due for removal with the old InfluxDB code (README TODO).
#   production form: http://<data02-host>:8086
INFLUXDB_URL=http://<data02-host>:8086
INFLUXDB_TOKEN=<influxdb-read-token>
INFLUXDB_ORG=<influxdb-org>

# Set in the container environment (compose), not in this file:
#   APP_ENV=production        selects /app/secrets/.env.production (default: development)
#   DASH_ASYNC_SUPPORT        only logged by app.py at start
