# Template of the nuki env file. NO REAL VALUES here: copy it, fill in the secrets, and
# keep the copy out of git (secrets/ is gitignored).
#
# The app reads /app/secrets/.env.<APP_ENV> at import (app/config.py), with APP_ENV set in
# the container environment (production: APP_ENV=production, so .env.production). In
# production this file is webapp_nuki.env in the dtu_sus_web_server secrets archive,
# bind-mounted read-only to /app/secrets/.env.production and readable only by uid 30000.

# Debug logging (True/False). Required.
DEBUG=False

# monitoring_db read API (data02). Optional in code (default
# http://host.docker.internal:8099, which only works in local development), but set
# it in production. Preferred form: the root of data02's nginx location /mdb/ (through
# nginx on port 80):
#   BACKEND_API_BASE_URL=http://<data02-host>/mdb        (production: http://192.38.87.126/mdb)
# The app calls <base>/api/v1/metadata, <base>/api/v2/metadata and
# <base>/api/v2/measurements/raw. A trailing /api/v1 or /api/v2 is accepted and stripped
# (a WARNING is logged at start), so env files with http://<data02-host>/mdb/api/v1 keep working.
BACKEND_API_BASE_URL=http://<data02-host>/mdb
# Optional, defaults shown: request timeout (s), retries of connection errors, backoff.
# Retries cover connection errors only: a 504 (the API's query timeout) or a read timeout is
# never retried.
BACKEND_API_TIMEOUT_SECONDS=30
BACKEND_API_MAX_RETRIES=2
BACKEND_API_BACKOFF_FACTOR=0.5
# Optional: most API requests in flight at once per dashboard update (the API has 4 workers,
# shared by all apps).
BACKEND_API_MAX_PARALLEL=2
# Optional: a long range is split into /raw requests of at most this many years.
BACKEND_API_RAW_CHUNK_YEARS=1
# Optional (v2 page): /daily requests cover at most this many hydrological years (split at 1 August).
BACKEND_API_DAILY_CHUNK_YEARS=3
# Optional (v2 page): seconds a download may spend starting API requests; after that it stops
# with "Download too large". Budget + BACKEND_API_TIMEOUT_SECONDS + workbook build must stay
# below the nginx/gunicorn limit of 120 s.
DOWNLOAD_TIME_BUDGET_S=75
# Optional: regular expression; only stations whose identifier fully matches are shown.
# Stations with the same name (e.g. "Nukissiorfiit Mast 9") are shown as one mast.
# An invalid expression stops the app at start.
NUKI_STATION_PATTERN=^(SIS2024-0[1-5]|NUKI202[0-9]-.+)$

# InfluxDB (data02, port 8086). Required by config.py although the app's data comes from
# the API; due for removal with the old InfluxDB code (README TODO).
#   production form: http://<data02-host>:8086
INFLUXDB_URL=http://<data02-host>:8086
INFLUXDB_TOKEN=<influxdb-read-token>
INFLUXDB_ORG=<influxdb-org>

# Set in the container environment (compose), not in this file:
#   APP_ENV=production        selects /app/secrets/.env.production (default: development)
#   DASH_ASYNC_SUPPORT        only logged by app.py at start
